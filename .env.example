# ============================================================================
# SWASTHYA SENSE — PRODUCTION API & DATABASE CONFIGURATION (.env.local)
# Copy this file to `.env.local` and fill in your credentials to switch from
# the embedded PGlite sandbox to live cloud APIs.
# ============================================================================

# 1. SUPABASE / POSTGRESQL DATABASE
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres"

# 2. WHATSAPP CLOUD API (META) OR TWILIO SMS GATEWAY (7 Regional Languages)
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# 3. 108 RAPID AMBULANCE DISPATCH & PARAMEDIC HANDOVER WEBHOOK
AMBULANCE_108_WEBHOOK_URL=""
AMBULANCE_108_API_KEY=""

# 4. HEALTH FACILITY REGISTRY (HFR / H3 HEXAGON MESH) & EHR / ABDM API
FACILITY_REGISTRY_API_URL=""
FACILITY_REGISTRY_API_KEY=""

# 5. FIELD-LEVEL PII ENCRYPTION KEY (AES-256-GCM FOR PATIENT PHONE NUMBERS)
PATIENT_PII_ENCRYPTION_KEY="32-byte-hex-or-base64-secret-key"

